#!/bin/sh
# Stops a push that contains an API key or private data (runs on EVERY push).
ROOT="$(git rev-parse --show-toplevel)"
for PY in python3 python py; do
    command -v "$PY" >/dev/null 2>&1 && exec "$PY" "$ROOT/tools/check_secrets.py" --push
done
echo "secret check: Python not found - push blocked to be safe." >&2
exit 1
